# Development tools for Makara (`brew bundle`, run by scripts/bootstrap.sh).
brew "uv"           # Python and the backend's locked dependencies
brew "deno"         # YouTube's JS challenges (gotcha 1)
brew "ffmpeg-full"  # libass, libwebp, zimg (gotcha 7)
brew "aria2"        # multi-connection downloads (gotcha 41)
brew "node"         # the Safari extension's tests
brew "gh"           # GitHub
