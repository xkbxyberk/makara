{
  "manifest_version": 3,
  "default_locale": "tr",
  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "version": "0.4.1",
  "icons": { "48": "images/icon-48.png", "96": "images/icon-96.png", "128": "images/icon-128.png" },
  "background": { "scripts": ["shared.js", "background.js"] },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["shared.js", "content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_title_none__",
    "default_icon": { "16": "images/toolbar-16.png", "32": "images/toolbar-32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+D", "mac": "MacCtrl+Shift+D" } }
  },
  "permissions": ["nativeMessaging", "storage", "tabs", "contextMenus", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
