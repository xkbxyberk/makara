    "download.modeHelp.separate" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her parça ayrı dosya: görüntü, her ses dili, her altyazı. Oynatıcılar aynı adlı altyazıyı kendiliğinden yükler." } } } },
