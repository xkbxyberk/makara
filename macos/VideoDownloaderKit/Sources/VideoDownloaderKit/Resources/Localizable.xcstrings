    "settings.notificationsHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Pencere arka plandayken bir indirme bitince veya başarısız olunca bildirim gösterir." } } } },
    "settings.safariLogin" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Giriş isteyen videolarda Safari oturumunu kullan" } } } },
    "settings.safariLoginHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yaş kısıtlı ya da yalnızca üyelere açık bir video önce her zamanki gibi oturumsuz denenir; site giriş isterse Safari’deki YouTube oturumunla bir kez daha denenir. Uygulamanın Tam Disk Erişimi olmalı. yt-dlp’nin uyarısı: hesapla indirmek, hesabın geçici ya da kalıcı kapatılması riskini taşır; bu yüzden oturum yalnızca gereken videolarda kullanılır." } } } },
    "settings.extensionOffer" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Safari’de video izlerken" } } } },
    "settings.extensionOffer.page" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sayfada indirmeyi öner" } } } },
    "settings.extensionOffer.icon" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yalnızca araç çubuğu simgesi" } } } },
    "settings.extensionOfferHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Öneri, oynattığın videonun köşesinde küçük bir kart olarak çıkar; her video için bir kez sorar, kapatılabilir ve bir sitede tamamen susturulabilir. Simge seçeneğinde eklenti yalnızca araç çubuğundaki simgesini yakar." } } } },
    "settings.accelerate" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hızlandırılmış indirme" } } } },
    "settings.accelerateHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir videoyu aynı anda birkaç bağlantıyla parça parça indirir: tek dosyalar aria2c ile, parçalı akışlar (HLS/DASH) yt-dlp’nin kendi paralel indirmesiyle. Yeni ayar bir sonraki başlatmada ya da sürdürmede geçerli olur." } } } },
    "settings.connections" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bağlantı sayısı" } } } },
    "settings.connectionsHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir indirme için en çok kaç bağlantı açılsın. Çok yüksek değerler bazı sitelerde yavaşlamaya ya da geçici engellemeye yol açabilir." } } } },
