    "error.COOKIES_UNREADABLE.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu video giriş istiyor ama uygulama Safari oturumunu okuyamıyor. Sistem Ayarları > Gizlilik ve Güvenlik > Tam Disk Erişimi’nde VideoDownloader’ı açıp uygulamayı yeniden başlat (Sistem ekranında kısayolu var)." } } } },
