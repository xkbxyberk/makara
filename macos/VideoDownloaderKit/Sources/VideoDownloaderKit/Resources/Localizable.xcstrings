    "doctor.check.aria2c" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "aria2c (hızlandırma)" } } } },
    "doctor.checkHelp.aria2c" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tek dosya olarak sunulan videoları aynı anda birkaç bağlantıyla, parça parça indirir. Yoksa bu videolar tek bağlantıyla iner; parçalı akışlar (HLS/DASH) yine paralel iner." } } } },
    "doctor.checkHelp.yt_dlp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Siteleri çözümleyen ve indiren bileşen. YouTube sık değiştiği için güncel tutulmalı." } } } },
    "doctor.checkHelp.js_runtime" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "YouTube, format listesini vermeden önce tarayıcıda JavaScript bulmacası çözdürüyor. Bunu çalıştıracak bir motor (deno veya node) olmazsa yt-dlp hata vermez ama bazı kaliteler listede hiç görünmez." } } } },
    "doctor.checkHelp.ffmpeg" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Parçaları birleştiren, dönüştüren ve kesen araç." } } } },
    "doctor.checkHelp.safari_session" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yaş kısıtlı ve giriş isteyen videolar için Safari’deki YouTube oturumun. Yalnızca çerezlerin adlarına bakılır (giriş yapılmış mı diye); değerleri hiçbir yerde gösterilmez ya da kaydedilmez." } } } },
    "doctor.session.off" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kapalı: giriş isteyen videolar oturumsuz denenir ve “giriş gerekiyor” der. Ayarlar’dan açılabilir." } } } },
    "doctor.session.unavailable" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Safari’nin çerez dosyası bulunamadı. Safari’yi bir kez açıp YouTube’a giriş yap." } } } },
    "doctor.session.no_access" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulama Safari oturumunu okuyamıyor: macOS bunun için Tam Disk Erişimi istiyor. Sistem Ayarları > Gizlilik ve Güvenlik > Tam Disk Erişimi’nde VideoDownloader’ı açıp uygulamayı yeniden başlat. (Sunucuyu Terminal’den başlattıysan izin Terminal’e verilmeli.)" } } } },
    "doctor.session.signed_out" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Safari’de YouTube’a giriş yapılmamış. Yaş kısıtlı videolar için Safari’de YouTube’a giriş yap." } } } },
    "doctor.session.signed_in" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hazır: Safari’de YouTube’a giriş yapılmış. Yalnızca giriş isteyen videolarda kullanılır." } } } },
    "doctor.session.unknown" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Safari oturumu okunabiliyor; YouTube’a giriş yapılıp yapılmadığı anlaşılamadı." } } } },
