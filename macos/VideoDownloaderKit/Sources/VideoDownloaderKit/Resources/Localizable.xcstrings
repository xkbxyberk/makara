    "library.allSites" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm siteler" } } } },
    "library.kindLabel" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tür" } } } },
    "library.siteLabel" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Site" } } } },
    "library.onlyMissing" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yalnızca eksikler" } } } },
    "library.scan" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dosyaları denetle" } } } },
    "library.scanHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Her öğenin dosyasının hâlâ yerinde olduğuna bakar. Finder’da taşınan dosyayı aynı boyut ve süreyle bulup bağlantıyı düzeltir; bulamadıklarını “Eksik” diye işaretler." } } } },
    "library.catalogueFailed" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir indirme tamamlandı ama kütüphaneye eklenemedi. Dosya diskte duruyor." } } } },
    "library.scanning" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Denetleniyor…" } } } },
    "library.loading" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kütüphane yükleniyor" } } } },
    "library.emptyTitle" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kütüphane boş" } } } },
    "library.emptyBody" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bitirdiğin her indirme burada, bilgileriyle birlikte listelenir." } } } },
    "library.noMatchTitle" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eşleşen öğe yok" } } } },
    "library.noMatchBody" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aramayı veya filtreleri değiştir." } } } },
    "library.missing" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Eksik" } } } },
    "library.missingHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dosya kaydedildiği yerde yok. Finder’da taşındıysa “Dosyaları denetle” aynı boyut ve süreye sahip dosyayı bulup bağlantıyı düzeltir. Kayıt hiçbir zaman kendiliğinden silinmez." } } } },
    "library.play" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Oynat" } } } },
    "library.playHelp" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Varsayılan oynatıcıda açar (IINA, QuickTime…)." } } } },
    "library.reveal" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Finder’da göster" } } } },
    "library.openInStudio" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Stüdyo’da aç" } } } },
