    "download.notice.WAV_NO_COVER" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "WAV dosyalarına kapak resmi gömülemez." } } } },
    "download.notice.DRM_MAYBE_SELECTED" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçilen parçalardan biri DRM korumalı olabilir; indirme başarısız olabilir." } } } },
    "download.notice.MACHINE_TRANSLATED_SUBS" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Makine çevirisi altyazı seçtin; hatalar içerebilir." } } } },
    "download.notice.UNKNOWN_SELECTION" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçimde artık bulunmayan bir parça var. Yeniden incele." } } } },
    "download.notice.CODEC_UNKNOWN" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu site kodek bilgisi vermiyor. Dosya indirildikten sonra incelenecek; QuickTime’da oynamayacaksa yeniden kodlanacak." } } } },
    "download.notice.VIDEO_REENCODE" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "{codec|Bu} görüntü QuickTime’da oynamaz; H.264’e yeniden kodlanacak. Bu yavaştır ve biraz kalite kaybettirir." } } } },
    "download.notice.COMPATIBLE_ALTERNATIVE" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeniden kodlamadan kaçınmak için doğrudan uyumlu olan {height}p H.264 sürümünü seçebilirsin." } } } },
    "download.notice.AUDIO_REENCODE" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "{codec|Bu} ses AAC’ye çevrilecek (hızlıdır, fark duyulmaz)." } } } },
    "download.notice.AUDIO_MODE_COPY" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "{codec|Ses} olduğu gibi kopyalanacak — kalite kaybı yok, kalite seçimi uygulanmaz." } } } },
    "download.notice.AUDIO_MODE_REENCODE" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "{codec|Ses} → {target^} yeniden kodlanacak. Kayıplı bir biçimden diğerine geçiş küçük bir kalite kaybı demektir." } } } },
    "download.notice.LOSSLESS_FROM_LOSSY" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kaynak {codec|kayıplı}; kayıpsız biçime çevirmek kaybolan kaliteyi geri getirmez, yalnızca dosyayı büyütür." } } } },
    "term.hdr.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "HDR" } } } },
    "term.hdr.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yüksek dinamik aralık. HDR10 ve Dolby Vision daha geniş renk ve parlaklık taşır ama eski ekranlarda soluk görünebilir. SDR her yerde doğru görünür." } } } },
    "term.manifest.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "akış" } } } },
    "term.manifest.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu format tek bir dosya değil, parçalara bölünmüş bir akıştan (HLS/DASH) geliyor. Boyutu kesin bilinmez ve tahmin genelde olduğundan büyük çıkar." } } } },
    "term.approxSize.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "tahmini" } } } },
    "term.approxSize.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kesin dosya boyutu bilinmiyor. Değer, bit hızı × süre ile hesaplandı; gerçek dosya bundan küçük olabilir." } } } },
    "term.drm.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "DRM" } } } },
    "term.drm.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "İçerik kopya korumalı. Bu uygulama DRM korumasını aşmaz; bu formatlar indirilemez." } } } },
    "term.muxed.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "ses dahil" } } } },
    "term.muxed.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu formatın içinde hem görüntü hem ses var. Ayrı ses parçası seçmene gerek kalmaz ama kalite seçeneği daha azdır." } } } },
    "term.format.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Format" } } } },
    "term.format.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "yt-dlp’nin bu parçaya verdiği kimlik. Aynı video farklı kalite ve kodeklerde birden çok format olarak sunulur." } } } },
    "term.fps.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "FPS" } } } },
    "term.fps.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Saniyedeki kare sayısı. 60 FPS hareketi daha akıcı gösterir; dosya biraz büyür." } } } },
    "term.codec.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kodek" } } } },
    "term.codec.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Görüntünün veya sesin sıkıştırılma yöntemi. Aynı kalitede AV1 en küçük, H.264 en uyumlu olandır." } } } },
    "term.bitrate.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bit hızı" } } } },
    "term.bitrate.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Saniyede kullanılan veri miktarı. Aynı kodekte daha yüksek bit hızı genelde daha iyi kalite ve daha büyük dosya demektir." } } } },
    "term.container.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kap" } } } },
    "term.container.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Parçaları taşıyan dosya türü (mp4, webm, mkv). Kodekten farklıdır: aynı görüntü farklı kaplara konabilir." } } } },
    "term.sampleRate.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Örnekleme" } } } },
    "term.sampleRate.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sesin saniyede kaç kez ölçüldüğü. 44,1 ve 48 kHz ikisi de CD kalitesi veya üstüdür." } } } },
    "term.channels.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kanal" } } } },
    "term.channels.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses kanalı sayısı: 1 mono, 2 stereo, 6 ise 5.1 çevresel ses." } } } },
    "term.aiUpscaled.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "YZ ile büyütülmüş" } } } },
    "term.aiUpscaled.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "YouTube bu çözünürlüğü yapay zekâ ile daha düşük çözünürlüklü orijinalden üretmiş. Daha net görünebilir ama gerçek bir kayıt değildir; arşiv için orijinal seçilir." } } } },
    "term.drc.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "DRC" } } } },
    "term.drc.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dinamik aralığı sıkıştırılmış ses: sessiz ve yüksek yerler birbirine yaklaştırılmış. Telefon hoparlöründe rahat duyulur ama orijinal değildir." } } } },
    "term.partialSize.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "en az" } } } },
    "term.partialSize.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seçtiğin parçaların bazılarının boyutu bilinmiyor; gösterilen değer yalnızca bilinenlerin toplamı." } } } },
    "term.remux.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "remux" } } } },
    "term.remux.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeniden kodlamadan, yalnızca kap (container) değiştirme. Hızlıdır ve kalite kaybı olmaz." } } } },
    "role.original" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Orijinal" } } } },
    "role.default" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Varsayılan" } } } },
    "role.dub" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dublaj" } } } },
    "role.descriptive" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sesli betimleme" } } } },
    "role.unknown" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses" } } } },
    "roleHelp.original" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Videonun asıl çekildiği dildeki ses. yt-dlp bunu language_preference=10 ile bildirir." } } } },
    "roleHelp.default" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "YouTube’un bu video için öntanımlı seçtiği ses. Orijinal olmak zorunda değil." } } } },
    "roleHelp.dub" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Başka bir dile seslendirilmiş parça. Dikkat: yt-dlp bunun insan seslendirmesi mi yoksa yapay zekâ dublajı mı olduğunu bildirmiyor — bu ayrımı yapmak mümkün değil." } } } },
    "roleHelp.descriptive" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Görme engelliler için sahneleri anlatan ek anlatım içeren ses." } } } },
    "roleHelp.unknown" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu videoda tek bir ses dili var. Karşılaştırılacak başka parça olmadığı için orijinal mi dublaj mı olduğu bilinmiyor." } } } },
    "codec.H.264" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "En yaygın video kodeği. Her Mac, iPhone ve tarayıcıda oynar; aynı kalite için AV1 ve VP9’dan daha büyük dosya üretir." } } } },
    "codec.HEVC" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "H.265. H.264’ün yaklaşık yarı boyutunda aynı kalite. Apple cihazlarında oynar, bazı tarayıcılarda oynamaz." } } } },
    "codec.AV1" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "En yeni ve en verimli video kodeği. Donanımla çözme M3 ve sonrası Mac’lerde, A17 Pro ve sonrası iPhone’larda var; eskilerde işlemciyi yorar." } } } },
    "codec.VP9" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Google’ın video kodeği. Tarayıcılarda ve VLC/IINA’da oynar; QuickTime ve iPhone Fotoğraflar açmaz." } } } },
    "codec.Dolby Vision" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dolby’nin HDR biçimi. Desteklemeyen ekran ve oynatıcılarda renkler yanlış görünebilir." } } } },
    "codec.AAC" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "En uyumlu ses kodeği. Apple cihazlarının hepsinde oynar." } } } },
    "codec.Opus" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aynı bit hızında AAC’den daha iyi ses kalitesi veren modern kodek. QuickTime ve iPhone’da MP4 içinde oynamaz." } } } },
    "inspectWarning.USED_SAFARI_LOGIN" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu video giriş istediği için Safari’deki YouTube oturumunla açıldı; indirmesi de oturumla yapılır." } } } },
    "inspectWarning.DRM_PRESENT" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu videonun bazı formatları DRM korumalı ve indirilemez." } } } },
    "inspectWarning.DRM_MAYBE" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bazı formatlar DRM korumalı olabilir; indirme sırasında başarısız olabilirler." } } } },
    "inspectWarning.SIZES_ARE_ESTIMATES" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu sitede kesin dosya boyutu bilgisi yok; gösterilen bütün boyutlar tahmindir." } } } },
    "inspectWarning.LIVE_CONTENT" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu bir canlı yayın. Canlı yayın desteği sonraki aşamalarda geliyor." } } } },
    "inspectWarning.PLAYLIST_TRACKS_NEED_PER_VIDEO_INSPECT" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Liste görünümü hızlı olsun diye kalite ve altyazı bilgisi çekilmedi." } } } },
    "inspectWarning.NO_JS_RUNTIME" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "JavaScript çalıştırıcı bulunamadı; YouTube’un bazı kaliteleri bu listede hiç görünmüyor olabilir. Sistem sekmesine bak." } } } },
    "inspectWarning.FORMATS_MAY_BE_MISSING" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "yt-dlp YouTube’un imza bulmacasını çözemedi; bazı kaliteler eksik. Genelde yt-dlp’yi güncellemek düzeltir." } } } },
    "clipboard.offer" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Panoya bir bağlantı kopyaladın:" } } } },
