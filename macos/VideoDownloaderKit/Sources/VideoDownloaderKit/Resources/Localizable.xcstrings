    "error.SESSION_NOT_ENOUGH.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Video Safari’deki oturumunla denendi ama yine giriş istendi. Safari’de YouTube’a giriş yapılmış mı, hesabın yaşı doğrulanmış mı? Sistem ekranındaki “Safari oturumu” satırına bak." } } } },
    "error.SETTINGS_UNAVAILABLE.title" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sistem Ayarları açılamadı" } } } },
    "error.SETTINGS_UNAVAILABLE.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sistem Ayarları > Gizlilik ve Güvenlik > Tam Disk Erişimi’ne elle git." } } } },
