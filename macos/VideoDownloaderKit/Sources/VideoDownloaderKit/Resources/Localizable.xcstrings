    "studio.notice.SEGMENTS_SEPARATE" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "{count|Birkaç} ayrı dosya yazılacak. Tek dosya için “birleştir”i işaretle." } } } },
    "studio.notice.CUT_MOVES_TO_KEYFRAME" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Başlangıç {requested} sn yerine {actual} sn olacak (en yakın anahtar kare). Tam an için “Kare hassas”ı seç." } } } },
    "studio.notice.SUBTITLE_NOT_IN_MP4" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "{codec|Bu} altyazısı resim tabanlı; MP4’e konamaz. MKV seç ya da izi kaldır." } } } },
    "studio.notice.CODEC_NOT_IN_MP4" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "{codec|Bu} izi MP4’e yeniden kodlanmadan konamaz. MKV seç ya da izi kaldır." } } } },
    "studio.notice.LEGACY_ENCODING" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu altyazı eski bir kodlamada ({charset|?}); Türkçe karakterler doğru okunacak ve çıktı UTF-8 olacak." } } } },
    "studio.terms.lossless.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kayıpsız" } } } },
    "studio.terms.lossless.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Görüntü yeniden kodlanmaz, kopyalanır: anında biter ve kalite kaybı olmaz, ama kesim yalnızca anahtar karelerde olabilir." } } } },
    "studio.terms.accurate.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kare hassas" } } } },
    "studio.terms.accurate.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tam istediğin karede keser. Bunun için görüntüyü yeniden kodlar: daha yavaş, çok az kalite kaybı." } } } },
    "studio.terms.keyframe.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "anahtar kare" } } } },
    "studio.terms.keyframe.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kendi başına çözülebilen tam kare. Aradaki kareler yalnızca farkları taşır; bu yüzden kopyalayarak yapılan kesim ancak anahtar karelerde başlayabilir." } } } },
    "studio.terms.loudnorm.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "EBU R128" } } } },
    "studio.terms.loudnorm.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yayın standardı ses yüksekliği ölçümü. Parçaları aynı algılanan seviyeye (-16 LUFS, podcast’lerin kullandığı değer) getirir; bölümler arasında ses açıp kısmak gerekmez." } } } },
    "studio.terms.remux.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Remux" } } } },
    "studio.terms.remux.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeniden kodlamadan kap (container) değiştirme ve izleri düzenleme. Hızlıdır ve kalite kaybı olmaz." } } } },
    "studio.terms.container.label" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kap" } } } },
    "studio.terms.container.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "MKV her şeyi taşır ama QuickTime açmaz; MP4/MOV Apple cihazlarında oynar ama bazı ses ve altyazı türlerini kabul etmez." } } } },
