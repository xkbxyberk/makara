    "error.FORBIDDEN.body" : { "localizations" : { "tr" : { "stringUnit" : { "state" : "translated", "value" : "Uygulama bir kez kendiliğinden yeniden denedi. Bu çoğu zaman geçicidir: birkaç dakika sonra “Tekrar dene”. Sürerse Sistem sekmesinden yt-dlp’yi güncelle." } } } },
